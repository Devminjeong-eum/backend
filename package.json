{
	"name": "devminjeong-eum-backend",
	"version": "0.0.1",
	"description": "데브말ㅆㆍ미 | 개발 용어 발음 사전 - 백엔드 레포지토리입니다",
	"author": "RookieAND <gwangin1999@naver.com>",
	"private": true,
	"license": "MIT",
	"scripts": {
		"format": "prettier \"{src, test}/**/*.ts\" --check",
		"format:fix": "prettier \"{src, test}/**/*.ts\" --write --check",
		"lint": "eslint \"{src, test}/**/*.ts\"",
		"lint:fix": "eslint \"{src, test}/**/*.ts\" --fix",
		"build:prod": "NODE_ENV=production nest build",
		"build:dev": "NODE_ENV=development nest build",
		"start:dev": "NODE_ENV=development nest start --watch",
		"start:debug": "NODE_ENV=development nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/main",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
		"migration:run": "npm run typeorm migration:run -- -d ./src/databases/migrations/data-source.ts",
		"migration:generate": "npm run typeorm -- -d ./src/databases/migrations/data-source.ts migration:generate ./src/databases/migrations/Migration",
		"migration:create": "npm run typeorm -- migration:create ./src/databases/migrations/Migration",
		"migration:revert": "npm run typeorm -- -d ./src/databases/migrations/data-source.ts migration:revert"
	},
	"dependencies": {
		"@aws-sdk/client-polly": "^3.614.0",
		"@aws-sdk/client-s3": "^3.614.0",
		"@aws-sdk/s3-request-presigner": "^3.614.0",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.2",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^4.0.2",
		"@nestjs/swagger": "^7.3.1",
		"@nestjs/typeorm": "^10.0.2",
		"axios": "^1.6.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.6",
		"dayjs": "^1.11.11",
		"dotenv": "^16.4.5",
		"drizzle-orm": "^0.38.4",
		"es-toolkit": "^1.31.0",
		"googleapis": "^135.1.0",
		"nanoid": "3.3.7",
		"nest-winston": "^1.9.4",
		"pg": "^8.11.5",
		"redis": "^4.6.14",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.20",
		"winston": "^3.13.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@swc/cli": "^0.3.12",
		"@swc/core": "^1.5.25",
		"@swc/jest": "^0.2.37",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"google-auth-library": "^9.9.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"reflect-metadata": "^0.2.2",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"typescript": "^5"
	}
}
