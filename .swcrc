{
	"$schema": "https://swc.rs/schema.json",
	"sourceMaps": true,
	"minify": false,
	"jsc": {
		"target": "es2022",
		"keepClassNames": true,
		"parser": {
			"syntax": "typescript",
			"decorators": true,
			"dynamicImport": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		},
		"baseUrl": ".",
		"paths": {
			"#/*": ["src/*"]
		}
	}
}